ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.3/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -g -fwrapv -O2 -Wall -g -fstack-protector-strong -Wformat -Werror=format-security -g -fwrapv -O2 -fPIC -I/home/liang/pytorch-env/lib/python3.10/site-packages/torch/include -I/home/liang/pytorch-env/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.3/include -I/home/liang/pytorch-env/include -I/usr/include/python3.10 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=custom_w4a16_gemv -std=c++20
cuda_cflags = -I/home/liang/pytorch-env/lib/python3.10/site-packages/torch/include -I/home/liang/pytorch-env/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.3/include -I/home/liang/pytorch-env/include -I/usr/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=custom_w4a16_gemv -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 -std=c++20
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /home/liang/Aletheia_W4A16_GEMV/build/temp.linux-x86_64-cpython-310/csrc/binding.o: compile /home/liang/Aletheia_W4A16_GEMV/csrc/binding.cpp
build /home/liang/Aletheia_W4A16_GEMV/build/temp.linux-x86_64-cpython-310/csrc/gemv_w4a16.o: cuda_compile /home/liang/Aletheia_W4A16_GEMV/csrc/gemv_w4a16.cu








